{
  "name": "cranecalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:permits": "tsx scripts/runPermitBenchmarks.ts",
    "review:runway": "tsx scripts/runRunwayReview.ts",
    "test:e2e": "playwright test",
    "review:published": "tsx scripts/runPublishedExamples.ts",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview:pages": "vite preview --host 127.0.0.1 --port 4175"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
